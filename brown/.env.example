# Copy to .env. Everything is optional.

# Workday page to watch (Find Student Jobs report)
WORKDAY_URL=https://wd5.myworkday.com/brown/d/task/1422$7750.htmld

# Enables Claude-based analysis of each posting. Without it, keyword rules are used.
ANTHROPIC_API_KEY=

# Email through Brevo. Use the SAME values as the GitHub Actions secrets of this repo
# (Settings > Secrets > Actions): BREVO_API_KEY, MAIL_FROM, ALERT_EMAIL_TO.
BREVO_API_KEY=
MAIL_FROM=
ALERT_EMAIL_TO=

# Extra alert channels (macOS notifications are always on)
# ntfy.sh topic name: install the ntfy app on your phone and subscribe to the same topic
NTFY_TOPIC=
# Discord webhook URL
DISCORD_WEBHOOK_URL=

# Set to 1 to also alert on borderline ("maybe passive") jobs
ALERT_ON_MAYBE=0
